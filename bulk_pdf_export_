    echo '<tr><th>Day ↓ / Time →</th>';
    foreach($slots as $slot) echo '<th>'.e(str_replace('-', ' - ', $slot)).'</th>';
    echo '</tr>';

    foreach($days as $di => $day){
        $isOnlineDay = false;
        if($view_type === 'division'){
            $hasAnyEntry = false;
            $hasAnyRoom = false;
            foreach(["08:45-09:40","09:40-10:35","10:50-11:45","11:45-12:40","01:40-02:35","02:35-03:30"] as $checkSlot){
                if(isset($timetable[$day][$checkSlot])){
                    foreach($timetable[$day][$checkSlot] as $entry){
                        $hasAnyEntry = true;
                        if(trim((string)($entry['room_code'] ?? '')) !== '') $hasAnyRoom = true;
                    }
                }
            }
            $isOnlineDay = ($hasAnyEntry && !$hasAnyRoom);
        }

        echo '<tr>';
        echo '<td class="day '.($isOnlineDay ? 'online-day' : '').'">'.e($day).($isOnlineDay ? '<br>(Online)' : '').'</td>';

        $skipNextSlot = false;
        foreach($slots as $slotIndex => $slot){
            if($skipNextSlot){ $skipNextSlot = false; continue; }

            if(isset($break_slots[$slot])){
                if($di === 0){
                    $cls = ($slot === '12:40-01:40') ? 'lunch-common' : 'break-common';
                    echo '<td rowspan="'.count($days).'" class="'.$cls.'">'.e($break_slots[$slot]).'</td>';
                }
                continue;
            }

            $colspan = 1;
            $nextSlot = $slots[$slotIndex + 1] ?? '';
            if($nextSlot !== '' && !isset($break_slots[$nextSlot]) && isset($timetable[$day][$slot]) && isset($timetable[$day][$nextSlot])){
                $currentSignature = [];
                foreach($timetable[$day][$slot] as $e){
                    $currentSignature[] = trim((string)($e['subject_code'] ?? '')).'|'.trim((string)($e['faculty_code'] ?? '')).'|'.trim((string)($e['room_code'] ?? '')).'|'.trim((string)($e['batch'] ?? ''));
                }
                $nextSignature = [];
                foreach($timetable[$day][$nextSlot] as $e){
                    $nextSignature[] = trim((string)($e['subject_code'] ?? '')).'|'.trim((string)($e['faculty_code'] ?? '')).'|'.trim((string)($e['room_code'] ?? '')).'|'.trim((string)($e['batch'] ?? ''));
                }
                sort($currentSignature); sort($nextSignature);

                $firstEntry = $timetable[$day][$slot][0] ?? [];
                $subjectCode = strtoupper(trim((string)($firstEntry['subject_code'] ?? '')));
                $subjectType = strtoupper(trim((string)($firstEntry['subject_type'] ?? '')));
                $subjectName = strtoupper(trim((string)($firstEntry['subject_name'] ?? '')));

                $mergeAllowed =
                    $subjectType === 'PRACTICAL' ||
                    strpos($subjectName, 'LAB') !== false ||
                    preg_match('/(L$|DSL|DMSL|PAIL|EEL|PLL|AIMLL|DLNNL|HPCL|BDAL|VAPTL|SOSL|BTL|ADAL|DAPPDL|FSDL|IDSL|IOTAL|ITML|DMAL|EDAL|CDEL|CFDL|CFL|DCL|DLECL|DSSL|MCAL|PP|APP|JP)/', $subjectCode) ||
                    strpos($subjectCode, 'PBL') !== false ||
                    strpos($subjectCode, 'PAL') !== false ||
                    strpos($subjectCode, 'SHD') !== false ||
                    strpos($subjectCode, 'MDM') !== false ||
                    in_array($subjectCode, ['LIBRARY','EXPERT','EXPERT SESSION','REMEDIAL','NPTEL','MOOC','MENTOR']);

                if($mergeAllowed && $currentSignature === $nextSignature){
                    $colspan = 2;
                    $skipNextSlot = true;
                }
            }

            echo '<td colspan="'.$colspan.'">';
            if(isset($timetable[$day][$slot])){
                $cellGroups = [];

                foreach($timetable[$day][$slot] as $entry){
                    $subject = trim((string)($entry['subject_code'] ?? ''));
                    $subjectName = trim((string)($entry['subject_name'] ?? ''));
                    $subjectType = trim((string)($entry['subject_type'] ?? ''));
                    $faculty = trim((string)($entry['faculty_code'] ?? ''));
                    $room = trim((string)($entry['room_code'] ?? ''));
                    $batch = trim((string)($entry['batch'] ?? ''));
                    $division = trim((string)($entry['division_name'] ?? ''));

                    if(in_array(strtoupper($subject), ['A','B']) && $batch === ''){
                        $batch = strtoupper($subject);
                        $subject = $subjectName;
                    }
                    if($subject === '' && $subjectName !== '') $subject = $subjectName;
                    if($subject === '') continue;

                    $key = strtoupper($subject);
                    if(!isset($cellGroups[$key])){
                        $cellGroups[$key] = [
                            'subject' => $subject,
                            'subject_name' => $subjectName,
                            'subject_type' => $subjectType,
                            'class' => subject_class_for_display($subject, $subjectName, $subjectType),
                            'entries' => []
                        ];
                    }

                    $entryKey = ($batch !== '' ? $batch : '-') . '|' . $division . '|' . $faculty . '|' . $room;
                    $cellGroups[$key]['entries'][$entryKey] = [
                        'batch' => $batch,
                        'division' => $division,
                        'faculty' => $faculty,
                        'room' => $room
                    ];
                }

                foreach($cellGroups as $group){
                    $entries = array_values($group['entries']);
                    usort($entries, function($a,$b){
                        $order = ['A'=>1,'B'=>2,'C'=>3,'D'=>4,''=>9];
                        $oa = $order[strtoupper($a['batch'])] ?? 8;
                        $ob = $order[strtoupper($b['batch'])] ?? 8;
                        if($oa === $ob) return strcmp($a['faculty'].$a['division'], $b['faculty'].$b['division']);
                        return $oa <=> $ob;
                    });

                    $textClass = $group['class'];
                    echo '<div class="tt-card">';
                    echo '<div class="tt-subject '.$textClass.'">'.e($group['subject']).'</div>';

                    foreach($entries as $meta){
                        $metaLine = '';
                        if($meta['batch'] !== '') $metaLine .= $meta['batch'].': ';

                        if($view_type === 'division'){
                            if($meta['faculty'] !== '') $metaLine .= $meta['faculty'];
                            if($meta['room'] !== '') $metaLine .= ($meta['faculty'] !== '' ? ' | ' : '') . $meta['room'];
                        } elseif($view_type === 'faculty'){
                            if($meta['division'] !== '') $metaLine .= $meta['division'];
                            if($meta['room'] !== '') $metaLine .= ($meta['division'] !== '' ? ' | ' : '') . $meta['room'];
                        } else {
                            if($meta['division'] !== '') $metaLine .= $meta['division'];
                            if($meta['faculty'] !== '') $metaLine .= ($meta['division'] !== '' ? ' | ' : '') . $meta['faculty'];
                        }

                        if(trim($metaLine) !== '') echo '<div class="tt-meta '.$textClass.'">'.e($metaLine).'</div>';
                    }
                    echo '</div>';
                }
            } else {
                echo '<div class="tt-card">-</div>';
            }
            echo '</td>';
        }
        echo '</tr>';
    }

    echo '</table>';
    if($view_type === 'division') render_division_footer($timetable);
    render_signature_footer($conn, $academic_year, $semester, $meta['department'] ?? 'GENERAL', $specialization ?: 'GENERAL', $preparedBy, $preparedDesignation);
    echo '</section>';
}

