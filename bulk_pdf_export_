function division_natural_order_sql(){
    return "ORDER BY
        CASE
            WHEN division_name LIKE 'FY%' THEN 1
            WHEN division_name LIKE 'SY%' THEN 2
            WHEN division_name LIKE 'TY%' THEN 3
            WHEN division_name LIKE 'LY%' THEN 4
            ELSE 5
        END,
        CAST(
            REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(division_name,'FY',''),'SY',''),'TY',''),'LY',''),' ',''),'-','') AS UNSIGNED
        ),
        division_name";
}
function get_items($conn, $view_type, $filters){
    if($view_type === 'division'){
        $where = ["1=1"];

        if($filters['department'] !== '' && column_exists($conn,'divisions','department')){
            $where[] = "department='".$conn->real_escape_string($filters['department'])."'";
        }
        if($filters['program_level'] !== '' && column_exists($conn,'divisions','program_level')){
            $where[] = "program_level='".$conn->real_escape_string($filters['program_level'])."'";
        }
        if($filters['degree_type'] !== '' && column_exists($conn,'divisions','degree_type')){
            $where[] = "degree_type='".$conn->real_escape_string($filters['degree_type'])."'";
        }
        if($filters['year_name'] !== '' && column_exists($conn,'divisions','year_name')){
            $where[] = "year_name='".$conn->real_escape_string($filters['year_name'])."'";
        }
        if($filters['specialization'] !== '' && column_exists($conn,'divisions','specialization')){
            $where[] = "specialization='".$conn->real_escape_string($filters['specialization'])."'";
        }
        if($filters['group'] !== '' && $filters['group'] !== 'ALL'){
            $safe = $conn->real_escape_string($filters['group']);
            $where[] = "division_name LIKE '{$safe}%'";
        }

        $sql = "SELECT division_name AS item FROM divisions WHERE ".implode(" AND ", $where)." ".division_natural_order_sql();
    } elseif($view_type === 'faculty'){
        $where = ["faculty_code IS NOT NULL", "faculty_code!=''"];
        if(column_exists($conn,'faculties','is_active')) $where[] = "(is_active IS NULL OR is_active='' OR is_active='Y')";
        $where[] = "faculty_code NOT IN ('ABBREVIATION','NULL','NONE','NAN')";
        $sql = "SELECT faculty_code AS item FROM faculties WHERE ".implode(" AND ", $where)." ORDER BY faculty_code";
    } else {
        $where = ["room_code IS NOT NULL", "room_code!=''"];
        if(column_exists($conn,'classrooms','resource_type') && $filters['resource_type'] !== 'all'){
            $rt = $conn->real_escape_string($filters['resource_type']);
            if($rt === 'tutorial'){
                $where[] = "(LOWER(resource_type) IN ('tutorial','tut','tutorial room','tut room') OR UPPER(room_code) LIKE 'TUT%')";
            } else {
                $where[] = "LOWER(resource_type)=LOWER('$rt')";
            }
        }
        $sql = "SELECT room_code AS item FROM classrooms WHERE ".implode(" AND ", $where)." ORDER BY room_code";
    }

    return @$conn->query($sql);
}
function fetch_timetable($conn, $view_type, $item, $academic_year, $semester){
    $ay = $academic_year;
    $sem = normalize_semester($semester);

    if($view_type === 'division'){
        $classTeacherJoin = table_exists($conn,'class_teacher_assignments') ? "
            LEFT JOIN class_teacher_assignments cta
              ON cta.division_id=d.id AND cta.academic_year=t.academic_year AND cta.semester=t.semester
        " : "";
        $settingsJoin = table_exists($conn,'timetable_settings') ? "
            LEFT JOIN timetable_settings ts
              ON ts.division_id=d.id AND ts.academic_year=t.academic_year AND ts.semester=t.semester
        " : "";

        $hasCtaTable = table_exists($conn,'class_teacher_assignments');
        $hasCtaEmail = $hasCtaTable && column_exists($conn,'class_teacher_assignments','class_teacher_email');
        $hasCtaContact = $hasCtaTable && column_exists($conn,'class_teacher_assignments','class_teacher_contact');
        $hasDivEmail = column_exists($conn,'divisions','class_teacher_email');
        $hasDivContact = column_exists($conn,'divisions','class_teacher_contact');

        $classTeacherSelect = $hasCtaTable ? "COALESCE(cta.class_teacher,d.class_teacher) AS class_teacher," : "d.class_teacher,";
        if($hasCtaEmail && $hasDivEmail){
            $classTeacherSelect .= " COALESCE(cta.class_teacher_email,d.class_teacher_email) AS class_teacher_email,";
        } elseif($hasCtaEmail){
            $classTeacherSelect .= " cta.class_teacher_email AS class_teacher_email,";
        } elseif($hasDivEmail){
            $classTeacherSelect .= " d.class_teacher_email AS class_teacher_email,";
        } else {
            $classTeacherSelect .= " '' AS class_teacher_email,";
        }

        if($hasCtaContact && $hasDivContact){
            $classTeacherSelect .= " COALESCE(cta.class_teacher_contact,d.class_teacher_contact) AS class_teacher_contact,";
        } elseif($hasCtaContact){
            $classTeacherSelect .= " cta.class_teacher_contact AS class_teacher_contact,";
        } elseif($hasDivContact){
            $classTeacherSelect .= " d.class_teacher_contact AS class_teacher_contact,";
        } else {
            $classTeacherSelect .= " '' AS class_teacher_contact,";
        }
        $wefSelect = table_exists($conn,'timetable_settings') ? "COALESCE(ts.wef_date,d.wef_date) AS wef_date, ts.prepared_by, ts.prepared_by_designation," : "d.wef_date, '' AS prepared_by, '' AS prepared_by_designation,";

        $sql = "SELECT
                    t.id,
                    d.id AS division_id,
                    d.division_name,
                    $classTeacherSelect
                    d.specialization,
                    d.department,
                    d.program_level,
                    d.degree_type,
                    d.year_name,
                    $wefSelect
                    t.day_name,
                    t.time_slot,
                    s.subject_code,
                    s.subject_name,
                    ".(column_exists($conn,'subjects','subject_type') ? "s.subject_type" : "'' AS subject_type").",
                    f.faculty_code,
                    f.faculty_name,
                    c.room_code,
                    t.batch
                FROM timetable_entries t
                JOIN divisions d ON t.division_id=d.id
                JOIN subjects s ON t.subject_id=s.id
                LEFT JOIN faculties f ON t.faculty_id=f.id
                LEFT JOIN classrooms c ON t.classroom_id=c.id
                $classTeacherJoin
                $settingsJoin
                WHERE d.division_name=?
                AND t.academic_year=?
                AND t.semester=?
                ORDER BY FIELD(t.day_name,'Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'), t.time_slot";
    } elseif($view_type === 'faculty'){
        $sql = "SELECT
                    t.id,
                    d.id AS division_id,
                    d.division_name,
                    d.department,
                    d.specialization,
                    t.day_name,
                    t.time_slot,
                    s.subject_code,
                    s.subject_name,
                    ".(column_exists($conn,'subjects','subject_type') ? "s.subject_type" : "'' AS subject_type").",
                    f.faculty_code,
                    f.faculty_name,
                    c.room_code,
                    t.batch
                FROM timetable_entries t
                JOIN faculties f ON t.faculty_id=f.id
                JOIN divisions d ON t.division_id=d.id
                JOIN subjects s ON t.subject_id=s.id
                LEFT JOIN classrooms c ON t.classroom_id=c.id
                WHERE f.faculty_code=?
                AND t.academic_year=?
                AND t.semester=?
                ORDER BY FIELD(t.day_name,'Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'), t.time_slot";
    } else {
        $sql = "SELECT
                    MIN(t.id) AS id,
                    GROUP_CONCAT(DISTINCT d.division_name ORDER BY d.division_name SEPARATOR ', ') AS division_name,
                    d.department,
                    d.specialization,
                    t.day_name,
                    t.time_slot,
                    s.subject_code,
                    s.subject_name,
                    ".(column_exists($conn,'subjects','subject_type') ? "s.subject_type" : "'' AS subject_type").",
                    f.faculty_code,
                    f.faculty_name,
                    c.room_code,
                    GROUP_CONCAT(DISTINCT t.batch ORDER BY t.batch SEPARATOR ', ') AS batch
                FROM timetable_entries t
                JOIN classrooms c ON t.classroom_id=c.id
                JOIN divisions d ON t.division_id=d.id
                JOIN subjects s ON t.subject_id=s.id
                LEFT JOIN faculties f ON t.faculty_id=f.id
                WHERE c.room_code=?
                AND t.academic_year=?
                AND t.semester=?
                GROUP BY d.department,d.specialization,t.day_name,t.time_slot,s.subject_code,s.subject_name,s.subject_type,f.faculty_code,f.faculty_name,c.room_code
                ORDER BY FIELD(t.day_name,'Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'), t.time_slot";
    }

    $stmt = $conn->prepare($sql);
    $stmt->bind_param("sss", $item, $ay, $sem);
    $stmt->execute();
    $res = $stmt->get_result();

    $timetable = [];
    $meta = [];
    while($row = $res->fetch_assoc()){
        $timetable[$row['day_name']][$row['time_slot']][] = $row;
        if(!$meta) $meta = $row;
    }
    return [$timetable, $meta];
}
function get_signature_rows($conn, $academic_year, $semester, $department='', $specialization=''){
    $defaults = [
        'PREPARED BY' => ['person_name'=>'', 'designation'=>'Dept. Timetable Coordinator', 'digital_signature_path'=>''],
        'CHECKED BY' => ['person_name'=>'', 'designation'=>'Chief Timetable Coordinator', 'digital_signature_path'=>''],
        'RECOMMENDED BY' => ['person_name'=>'', 'designation'=>'Associate Dean (Academics)', 'digital_signature_path'=>''],
        'APPROVED BY' => ['person_name'=>'', 'designation'=>'Dean', 'digital_signature_path'=>'']
    ];

    if(!table_exists($conn,'timetable_signatures')) return $defaults;

    $ay = $conn->real_escape_string($academic_year);
    $sem = $conn->real_escape_string(normalize_semester($semester));
    $dept = $conn->real_escape_string($department ?: 'GENERAL');
    $spec = $conn->real_escape_string($specialization ?: 'GENERAL');

    $digCol = column_exists($conn,'timetable_signatures','digital_signature_path') ? "digital_signature_path" : "'' AS digital_signature_path";

    $sql = "
        SELECT role_name, person_name, designation, $digCol, department_name, specialization
        FROM timetable_signatures
        WHERE academic_year='$ay' AND semester='$sem'
          AND (department_name='$dept' OR department_name='GENERAL' OR department_name='' OR department_name IS NULL)
          AND (specialization='$spec' OR specialization='GENERAL' OR specialization='' OR specialization IS NULL)
        ORDER BY
          CASE WHEN department_name='$dept' AND specialization='$spec' THEN 1
               WHEN department_name='$dept' THEN 2
               WHEN department_name='GENERAL' THEN 3
               ELSE 4 END,
          display_order, id
    ";
    $res = @$conn->query($sql);
    if($res){
        while($r = $res->fetch_assoc()){
            $role = strtoupper(trim((string)$r['role_name']));
            if(isset($defaults[$role])){
                if(trim((string)$r['person_name']) !== '' || trim((string)$r['designation']) !== '' || trim((string)$r['digital_signature_path']) !== ''){
                    $defaults[$role] = [
                        'person_name' => $r['person_name'] ?? '',
                        'designation' => $r['designation'] ?? '',
                        'digital_signature_path' => $r['digital_signature_path'] ?? ''
                    ];
                }
            }
        }
    }
    return $defaults;
}
function render_division_footer($timetable){
    $legend_rows = [];
    foreach($timetable as $slotArr){
        foreach($slotArr as $entries){
            foreach($entries as $entry){
                $sc = trim($entry['subject_code'] ?? '');
                $sn = trim($entry['subject_name'] ?? '');
                $fc = trim($entry['faculty_code'] ?? '');
                $fn = trim($entry['faculty_name'] ?? '');
                if(!clean_subject_for_legend($sc, $sn)) continue;

                if(!isset($legend_rows[$sc])){
                    $legend_rows[$sc] = [
                        'subject_name' => $sn ?: $sc,
                        'subject_code' => $sc,
                        'faculty_names' => [],
                        'faculty_codes' => []
                    ];
                }

                if(clean_faculty_for_legend($fc, $fn)){
                    $legend_rows[$sc]['faculty_names'][$fc] = $fn ?: $fc;
                    $legend_rows[$sc]['faculty_codes'][$fc] = $fc;
                }
            }
        }
    }

    if(empty($legend_rows)) return;

    echo '<table class="legend-table">';
    echo '<tr><th>Name of the Course</th><th>Abbreviation</th><th>Name of the Faculty</th><th>Abbreviation</th></tr>';
    foreach($legend_rows as $row){
        echo '<tr>';
        echo '<td>'.e($row['subject_name']).'</td>';
        echo '<td class="legend-code">'.e($row['subject_code']).'</td>';
        echo '<td>'.e(implode(", ", array_values($row['faculty_names']))).'</td>';
        echo '<td class="legend-code">'.e(implode(", ", array_values($row['faculty_codes']))).'</td>';
        echo '</tr>';
    }
    echo '</table>';
}
