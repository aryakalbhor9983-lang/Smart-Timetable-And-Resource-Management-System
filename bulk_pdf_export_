function e($v){ return htmlspecialchars($v ?? '', ENT_QUOTES); }
function table_exists($conn, $table){
    $safe = $conn->real_escape_string($table);
    $res = @$conn->query("SHOW TABLES LIKE '$safe'");
    return $res && $res->num_rows > 0;
}
function column_exists($conn, $table, $column){
    $safeTable = $conn->real_escape_string($table);
    $safeCol = $conn->real_escape_string($column);
    $res = @$conn->query("SHOW COLUMNS FROM `$safeTable` LIKE '$safeCol'");
    return $res && $res->num_rows > 0;
}
function ensure_column($conn, $table, $column, $definition){
    if(table_exists($conn, $table) && !column_exists($conn, $table, $column)){
        @$conn->query("ALTER TABLE `$table` ADD COLUMN `$column` $definition");
    }
}
function q1($conn, $sql, $default=''){
    $res = @$conn->query($sql);
    if(!$res) return $default;
    $row = $res->fetch_assoc();
    if(!$row) return $default;
    return array_values($row)[0] ?? $default;
}
function normalize_semester($sem){
    $sem = trim((string)$sem);
    if($sem === 'Sem-I' || $sem === 'Sem 1' || $sem === 'Semester I' || $sem === '1') return 'Odd';
    if($sem === 'Sem-II' || $sem === 'Sem 2' || $sem === 'Semester II' || $sem === '2') return 'Even';
    if($sem === '') return 'Odd';
    return $sem;
}
function format_wef_date_display($dateValue){
    $dateValue = trim((string)$dateValue);
    if($dateValue === '') return '';
    $ts = strtotime($dateValue);
    if($ts === false) return $dateValue;
    return date('jS F Y', $ts);
}
function subject_class_for_display($code, $name='', $type=''){
    $code = strtoupper(trim((string)$code));
    $name = strtoupper(trim((string)$name));
    $type = strtoupper(trim((string)$type));
    $combo = $code.' '.$name.' '.$type;

    if(strpos($combo,'PBL') !== false || strpos($combo,'PROJECT') !== false || strpos($combo,'REVIEW') !== false || strpos($combo,'MPP') !== false){
        return 'project';
    }
    if($type === 'PRACTICAL' || strpos($combo,'LAB') !== false || preg_match('/(L$|DSL|DMSL|PAIL|EEL|PLL|AIMLL|DLNNL|HPCL|BDAL|VAPTL|SOSL|BTL|ADAL|DAPPDL|FSDL|IDSL|IOTAL|ITML|DMAL|EDAL|CDEL|CFDL|CFL|DCL|DLECL|DSSL|MCAL|PP|APP|JP)/', $code)){
        return 'practical';
    }
    if($type === 'OTHER' || in_array($code, ['LIBRARY','MENTOR','MOOC','NPTEL','EXPERT','EXPERT SESSION','SCIL','SCIL-APT','SCIL-PS','REMEDIAL','TRAINING & PLACEMENT ACTIVITY'])){
        return 'other';
    }
    return '';
}
function clean_subject_for_legend($code, $name=''){
    $code = trim((string)$code);
    $name = trim((string)$name);
    $uCode = strtoupper($code);
    $uName = strtoupper($name);
    if($code === '' || $name === '') return false;
    if($uCode === $uName) return false;
    if(in_array($uCode, ['A','B','ONLINE','NULL','NONE','NAN','LIBRARY','MEETING','MENTOR','BREAK','SHORT BREAK','LUNCH BREAK','PREPARED BY','CHECKED BY','RECOMMENDED BY','APPROVED BY'])) return false;
    if(preg_match('/^[NS][0-9]{3,4}$/', $uCode)) return false;
    if(strpos($uCode, 'WEEK') !== false || strpos($uName, 'WEEK') !== false) return false;
    return true;
}
function clean_faculty_for_legend($code, $name=''){
    $code = trim((string)$code);
    $name = trim((string)$name);
    $uCode = strtoupper($code);
    $uName = strtoupper($name);
    if($code === '' || $name === '') return false;
    if($uCode === $uName) return false;
    if(in_array($uCode, ['ONLINE','NULL','NONE','NAN','PREPARED BY','CHECKED BY','RECOMMENDED BY','APPROVED BY'])) return false;
    if(preg_match('/^[NS][0-9]{3,4}$/', $uCode)) return false;
    if(strpos($uCode, 'PM') !== false || strpos($uCode, 'WEEK') !== false) return false;
    return true;
}

